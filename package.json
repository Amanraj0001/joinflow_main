{
  "name": "joinflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/serve.js --dev",
    "build": "prisma generate && vite build",
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:local": "node scripts/local-db.js",
    "test": "node --env-file-if-exists=.env scripts/test-runner.js",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-runner.js --browser"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/groq": "^1.0.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.6.0",
    "pino": "^10.0.0",
    "prisma": "6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "embedded-postgres": "^18.1.0-beta.15",
    "postcss": "^8.5.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
